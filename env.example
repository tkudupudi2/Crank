# Auth0 MFA Configuration (Optional - for enhanced security)
AUTH0_MFA_ENABLED=true
AUTH0_MFA_PROVIDER=guardian

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
