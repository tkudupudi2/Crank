// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  transactions     Transaction[]
  payments         Payment[]
  paymentSchedules PaymentSchedule[]
  plaidItems       PlaidItem[]
  syncStatus       SyncStatus?
  userPreferences  UserPreferences?

  @@map("users")
}

model Account {
  id              String    @id @default(cuid())
  userId          String
  plaidAccountId  String?   @unique // Made optional for virtual accounts
  plaidItemId     String?   // Made optional for virtual accounts
  institutionId   String?   // Made optional for virtual accounts
  institutionName String
  name            String
  type            String    // 'credit', 'depository', 'loan', 'investment', 'other'
  subtype         String?   // 'credit_card', 'checking', 'savings', 'mortgage', 'student', 'cash', 'other', etc.
  mask            String?   // Last 4 digits
  currentBalance  Float?
  availableBalance Float?
  currencyCode    String    @default("USD")
  dueDate         DateTime? // For credit cards: payment due date
  minimumPayment  Float?    // For credit cards: minimum payment required
  // Additional liability fields
  creditLimit     Float?    // For credit cards: credit limit
  lastPaymentAmount Float?  // For credit cards: last payment amount
  lastPaymentDate DateTime? // For credit cards: last payment date
  aprs            Json?     // For credit cards: APR information as JSON
  // Mortgage fields
  originalBalance Float?    // For mortgages: original loan amount
  escrowBalance   Float?    // For mortgages: escrow balance
  interestRatePercentage Float? // For mortgages: interest rate
  interestRateType String?  // For mortgages: fixed/variable
  originalTerm    Int?      // For mortgages: original term in months
  maturityDate    DateTime? // For mortgages: loan maturity date
  originationDate DateTime? // For mortgages: loan origination date
  originationPrincipalAmount Float? // For mortgages: original principal
  principalBalance Float?   // For mortgages: principal balance
  propertyAddress Json?     // For mortgages: property address as JSON
  ytdInterestPaid Float?    // For mortgages: year-to-date interest paid
  ytdPrincipalPaid Float?   // For mortgages: year-to-date principal paid
  // Student loan fields
  repaymentPlan   String?   // For student loans: repayment plan type
  sequenceNumber  Int?      // For student loans: sequence number
  servicerAddress Json?     // For student loans: servicer address as JSON
  lastUpdated     DateTime? // Last time account data was updated
  isActive        Boolean   @default(true)
  isVirtual       Boolean   @default(false) // For manual/virtual accounts
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  paymentsFrom    Payment[]       @relation("PaymentFromAccount")
  paymentsTo      Payment[]       @relation("PaymentToAccount")
  schedulesFrom   PaymentSchedule[] @relation("ScheduleFromAccount")
  schedulesTo     PaymentSchedule[] @relation("ScheduleToAccount")

  @@map("accounts")
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  accountId       String
  plaidTransactionId String @unique
  amount          Float
  description     String
  merchantName    String?
  category        String[]
  subcategory     String?
  date            DateTime
  pending         Boolean   @default(false)
  accountOwner    String?
  isManual        Boolean   @default(false) // For manually added transactions
  // Location fields from Plaid
  address         String?   // Street address
  city            String?   // City
  region          String?   // State or province
  postalCode      String?   // Postal/ZIP code
  country         String?   // Country code
  storeNumber     String?   // Store number
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  fromAccountId   String    // Bank account to pay from
  toAccountId     String    // Credit card to pay to
  amount          Float
  description     String?
  status          String    @default("pending") // 'pending', 'processing', 'completed', 'failed', 'cancelled'
  paymentType     String    @default("manual") // 'manual', 'scheduled', 'auto'
  scheduledDate   DateTime? // When payment should be processed
  processedDate   DateTime? // When payment was actually processed
  failureReason   String?   // Reason if payment failed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("PaymentFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("PaymentToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PlaidItem {
  id           String   @id @default(cuid())
  userId       String
  plaidItemId  String   @unique
  accessToken  String   @unique
  institutionId String
  institutionName String
  status       String   @default("active")
  lastError    String?  // Last error message if status is error
  lastSyncAt   DateTime?
  lastUpdated  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plaid_items")
}

model PaymentSchedule {
  id              String    @id @default(cuid())
  userId          String
  fromAccountId   String    // Bank account to pay from
  toAccountId     String    // Credit card to pay to
  amount          Float?
  paymentType     String    // 'minimum', 'full_balance', 'custom'
  frequency       String    @default("monthly") // 'monthly', 'weekly', 'bi_weekly'
  dayOfMonth      Int?      // For monthly: day of month (1-31)
  dayOfWeek       Int?      // For weekly: day of week (0-6, Sunday=0)
  isActive        Boolean   @default(true)
  nextPaymentDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("ScheduleFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("ScheduleToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@map("payment_schedules")
}

model SyncStatus {
  id           String   @id @default(cuid())
  userId       String   @unique
  hasInitialSync Boolean @default(false)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sync_status")
}

model UserPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  budgetCategoryOrder     String[] // Array of category IDs in user's preferred order
  budgetCategoryBudgets   Json     // Object mapping category IDs to budget amounts
  budgetCategoryColors    Json     // Object mapping category IDs to color classes
  budgetPreferences       Json?    // Object containing budget settings (total budget, duration, etc.)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model WebhookEvent {
  id              String    @id @default(cuid())
  webhookId       String    @unique
  webhookType     String    // 'TRANSACTIONS', 'ACCOUNTS', 'ITEM', 'LIABILITIES'
  webhookCode     String    // 'INITIAL_UPDATE', 'BALANCE', 'ERROR', etc.
  itemId          String?   // Plaid item ID
  processed       Boolean   @default(false)
  error           String?   // Error message if processing failed
  payload         Json      // Full webhook payload
  processedAt     DateTime?
  processingTimeMs Int?     // Processing time in milliseconds
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("webhook_events")
}

