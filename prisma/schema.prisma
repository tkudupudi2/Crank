// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  firstName String?
  lastName  String?
  onboardingCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  transactions     Transaction[]
  payments         Payment[]
  paymentSchedules PaymentSchedule[]
  plaidItems       PlaidItem[]
  syncStatus       SyncStatus?
  userPreferences  UserPreferences?
  feedback         Feedback[]
  conversations    Conversation[]

  @@map("users")
}

model Account {
  id              String    @id @default(cuid())
  userId          String
  plaidAccountId  String?   @unique // Made optional for virtual accounts
  plaidItemId     String?   // Made optional for virtual accounts
  institutionId   String?   // Made optional for virtual accounts
  institutionName String    // Keep unencrypted for Plaid syncing
  name            String?   // Made nullable - encrypted in nameEnc
  type            String    // Keep unencrypted for Plaid syncing
  subtype         String?   // Made nullable - encrypted in subtypeEnc
  mask            String?   // Made nullable - encrypted in maskEnc
  // Encrypted mirrors for PII/descriptive fields
  nameEnc         String?
  maskEnc         String?
  subtypeEnc      String?
  servicerAddressEnc String?
  propertyAddressEnc String?
  repaymentPlanEnc String?
  currentBalance  Float?
  availableBalance Float?
  // Encrypted/derived mirrors for numeric/date fields (Step 2)
  currentBalanceEnc String?
  availableBalanceEnc String?
  creditLimitEnc   String?
  lastPaymentAmountEnc String?
  lastPaymentDateEnc String?
  currentBalanceNum Float?
  availableBalanceNum Float?
  creditLimitNum   Float?
  lastPaymentAmountNum Float?
  lastPaymentDateUtc DateTime?
  currencyCode    String    @default("USD")
  dueDate         DateTime? // For credit cards: payment due date
  minimumPayment  Float?    // For credit cards: minimum payment required
  // Additional liability fields (kept for Plaid compatibility, encrypted in _Enc columns)
  creditLimit     Float?    // For credit cards: credit limit - nullable, encrypted in creditLimitEnc
  lastPaymentAmount Float?  // For credit cards: last payment amount - nullable, encrypted in lastPaymentAmountEnc
  lastPaymentDate DateTime? // For credit cards: last payment date - nullable, encrypted in lastPaymentDateEnc
  aprs            Json?     // For credit cards: APR information as JSON
  // Mortgage fields
  originalBalance Float?    // For mortgages: original loan amount
  escrowBalance   Float?    // For mortgages: escrow balance
  interestRatePercentage Float? // For mortgages: interest rate
  interestRateType String?  // For mortgages: fixed/variable
  originalTerm    Int?      // For mortgages: original term in months
  maturityDate    DateTime? // For mortgages: loan maturity date
  originationDate DateTime? // For mortgages: loan origination date
  originationPrincipalAmount Float? // For mortgages: original principal
  principalBalance Float?   // For mortgages: principal balance
  propertyAddress Json?     // For mortgages: property address as JSON
  ytdInterestPaid Float?    // For mortgages: year-to-date interest paid
  ytdPrincipalPaid Float?   // For mortgages: year-to-date principal paid
  // Student loan fields
  repaymentPlan   String?   // For student loans: repayment plan type
  sequenceNumber  Int?      // For student loans: sequence number
  servicerAddress Json?     // For student loans: servicer address as JSON
  lastUpdated     DateTime? // Last time account data was updated
  isActive        Boolean   @default(true)
  isVirtual       Boolean   @default(false) // For manual/virtual accounts
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  paymentsFrom    Payment[]       @relation("PaymentFromAccount")
  paymentsTo      Payment[]       @relation("PaymentToAccount")
  schedulesFrom   PaymentSchedule[] @relation("ScheduleFromAccount")
  schedulesTo     PaymentSchedule[] @relation("ScheduleToAccount")

  @@map("accounts")
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  accountId       String
  plaidTransactionId String @unique // Keep unencrypted for Plaid syncing
  amount          Float?   // Made nullable - encrypted in amountEnc, derived in amountNum
  description     String?  // Made nullable - encrypted in descriptionEnc
  merchantName    String?  // Made nullable - encrypted in merchantNameEnc
  category        String[] // Keep unencrypted array for queries, encrypted JSON in categoryEnc
  subcategory     String?  // Made nullable - encrypted in subcategoryEnc
  date            DateTime? // Made nullable - encrypted in dateEnc, derived in dateUtc
  // Encrypted/derived mirrors for numeric/date fields (Step 2)
  amountEnc       String?
  dateEnc         String?
  amountNum       Float?
  dateUtc         DateTime?
  pending         Boolean   @default(false)
  accountOwner    String?
  isManual        Boolean   @default(false) // For manually added transactions
  // Location fields from Plaid
  address         String?   // Street address
  city            String?   // City
  region          String?   // State or province
  postalCode      String?   // Postal/ZIP code
  country         String?   // Country code
  storeNumber     String?   // Store number
  // Encrypted mirrors for PII/descriptive fields
  descriptionEnc  String?
  merchantNameEnc String?
  accountOwnerEnc String?
  addressEnc      String?
  cityEnc         String?
  regionEnc       String?
  postalCodeEnc   String?
  countryEnc      String?
  storeNumberEnc  String?
  subcategoryEnc  String?
  categoryEnc     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  fromAccountId   String    // Bank account to pay from
  toAccountId     String    // Credit card to pay to
  amount          Float
  description     String?
  status          String    @default("pending") // 'pending', 'processing', 'completed', 'failed', 'cancelled'
  paymentType     String    @default("manual") // 'manual', 'scheduled', 'auto'
  scheduledDate   DateTime? // When payment should be processed
  processedDate   DateTime? // When payment was actually processed
  failureReason   String?   // Reason if payment failed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("PaymentFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("PaymentToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PlaidItem {
  id           String   @id @default(cuid())
  userId       String
  plaidItemId  String   @unique
  accessToken  String   @unique
  institutionId String
  institutionName String
  status       String   @default("active")
  lastError    String?  // Last error message if status is error
  lastSyncAt   DateTime?
  lastUpdated  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plaid_items")
}

model PaymentSchedule {
  id              String    @id @default(cuid())
  userId          String
  fromAccountId   String    // Bank account to pay from
  toAccountId     String    // Credit card to pay to
  amount          Float?
  paymentType     String    // 'minimum', 'full_balance', 'custom'
  frequency       String    @default("monthly") // 'monthly', 'weekly', 'bi_weekly'
  dayOfMonth      Int?      // For monthly: day of month (1-31)
  dayOfWeek       Int?      // For weekly: day of week (0-6, Sunday=0)
  isActive        Boolean   @default(true)
  nextPaymentDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("ScheduleFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("ScheduleToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@map("payment_schedules")
}

model SyncStatus {
  id           String   @id @default(cuid())
  userId       String   @unique
  hasInitialSync Boolean @default(false)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sync_status")
}

model UserPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  budgetCategoryOrder     String[] // Array of category IDs in user's preferred order
  budgetCategoryBudgets   Json     // Object mapping category IDs to budget amounts
  budgetCategoryColors    Json     // Object mapping category IDs to color classes
  budgetPreferences       Json?    // Object containing budget settings (total budget, duration, etc.)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model WebhookEvent {
  id              String    @id @default(cuid())
  webhookId       String    @unique
  webhookType     String    // 'TRANSACTIONS', 'ACCOUNTS', 'ITEM', 'LIABILITIES'
  webhookCode     String    // 'INITIAL_UPDATE', 'BALANCE', 'ERROR', etc.
  itemId          String?   // Plaid item ID
  processed       Boolean   @default(false)
  error           String?   // Error message if processing failed
  payload         Json      // Full webhook payload
  processedAt     DateTime?
  processingTimeMs Int?     // Processing time in milliseconds
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("webhook_events")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'bug', 'feature', 'improvement'
  message     String   // The feedback content
  status      String   @default("new") // 'new', 'in_progress', 'resolved', 'closed', 'done'
  priority    String?  // 'low', 'medium', 'high', 'critical' - null by default
  tags        String[] // Array of tags for categorization
  metadata    Json?    // Additional metadata (browser info, user agent, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments FeedbackComment[]

  @@map("feedback")
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  comment    String   // The comment content
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("feedback_comments")
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String
  query      String
  intent     String
  entities   Json
  response   String
  confidence Float
  method     String?  // ML method used (rule_based, ml_enhanced, etc.)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

